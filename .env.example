# Public Supabase project configuration
# Use the publishable/anon key only. Never place a service-role key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional public application URL used by redirects and canonical links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secret key (sb_secret_… or legacy service_role). NEVER prefix
# with NEXT_PUBLIC_. Used only by server code to create short-lived signed
# download URLs for customer portal files after the payment check passes.
# Without it customer downloads return 503.
SUPABASE_SECRET_KEY=
