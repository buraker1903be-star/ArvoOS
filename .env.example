# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
# Yalnızca publishable/anon anahtar. Service-role anahtarını ASLA
# NEXT_PUBLIC_ ile başlatmayın.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Yalnızca sunucu tarafı (sb_secret_… ya da eski service_role). RLS'i atlar:
# çağıran taraf yetkiyi kendisi doğrular (lib/supabase/admin.ts). Müşteri
# portal dosyalarının kısa ömürlü imzalı adresleri, PayTR işlemleri ve
# platform yönetimi bunu kullanır. Eksikse müşteri indirmeleri 503 döner.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- PayTR mağaza anahtarlarının şifrelenmesi ---
# Kurumların merchant_key/merchant_salt değerleri veritabanına düz yazılmaz;
# AES-256-GCM ile şifrelenir (lib/payment-credentials.ts). 32 baytlık base64:
#   openssl rand -base64 32
# Eksikse Ayarlar ekranındaki PayTR bağlama alanı açılmaz.
# Bu değer değişirse şifreli kayıtlar okunamaz hale gelir.
PAYMENT_CREDENTIALS_KEY=

# --- ArvoLab köprüsü (bireysel abonelik) ---
# ArvoLab ayrı bir Supabase projesinde. Lisans durumu her istekte sorulmaz;
# ArvoOS değişiklik oldukça ArvoLab'a yazar (lib/arvolab.ts). İkisi de boşsa
# köprü kapalıdır: ArvoLab son bilinen duruma göre çalışır.
ARVOLAB_SUPABASE_URL=
ARVOLAB_SUPABASE_SECRET_KEY=

# ARC köprüsü (lib/arc-bridge.ts). ARC kendi Supabase projesine taşındığında
# (ArvoARC/AYRILMA.md) kurum, ARC lisansı, ticaret modülü ve personel oraya
# yazılır. Boşsa köprü kapalıdır — taşıma gününe kadar böyle kalmalı.
# SECRET_KEY: ARC projesinin sb_secret_… anahtarı (service role).
ARC_SUPABASE_URL=
ARC_SUPABASE_SECRET_KEY=

# Arvo Randevu köprüsü (lib/randevu-bridge.ts): salon lisansını ve personeli
# ArvoRandevu projesine (wqbifmimkpvvmvrnskxa) yazar. Secret anahtar
# (sb_secret_…), ArvoRandevu projesinden. Boşsa köprü kapalı: salon
# lisansları Randevu'ya yansımaz, Platform sayfası uyarır. /api/cron/randevu-sync
# aynı CRON_SECRET'ı kullanır.
RANDEVU_SUPABASE_URL=
RANDEVU_SUPABASE_SECRET_KEY=

# Vercel zamanlayıcısının anahtarı: /api/cron/arc-sync yalnızca bu anahtarla
# çağrılabilir. Boşsa uç kapalıdır (401) ve ARC eşitlemesi yalnızca anında
# aktarımlarla yürür.
CRON_SECRET=

# Bireysel abonenin durumunu sorduğu uç (app/api/bridge/subscription).
# ArvoLab tarafındaki PRODUCT_BRIDGE_SECRET ile birebir aynı olmalıdır;
# farklıysa Platform ekranı "köprü yanıt vermiyor" uyarısı gösterir ve
# bireysel kullanıcılar engellenmediği için ücretsiz kullanmaya devam eder.
# ASLA NEXT_PUBLIC_ ile başlatmayın.
PRODUCT_BRIDGE_SECRET=

# --- Pazarlama sitesi talep formu ---
# Form imzasının HMAC anahtarı (app/_site/lead-actions.ts). Canlıda mutlaka
# tanımlanmalı: boşsa kod içindeki sabit yedeğe düşer ve imza tahmin
# edilebilir hale gelir.
SITE_LEAD_SALT=

# --- Vercel alan adı bağlama (kurum kendi alan adını ekler) ---
# Ayarlar → Alan adı ekranı Vercel API'siyle konuşur (lib/vercel-domains.ts).
# Token ya da proje kimliği eksikse ekran "Vercel entegrasyonu
# yapılandırılmamış" der, panel geri kalanı etkilenmez.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Proje bir takıma aitse zorunlu, kişisel hesapta boş bırakılır.
VERCEL_TEAM_ID=
